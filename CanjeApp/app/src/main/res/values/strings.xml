    <!-- Pantalla 3: Descripción del proyecto -->
    <string name="project_title">Sobre el Proyecto</string>
    <string name="project_subtitle">Problemática, solución y hardware</string>
    <string name="problem_title">Problemática</string>
    <string name="problem_description">No existen métodos rápidos y confiables para entregar códigos promocionales presenciales vinculados a un sistema de canje de puntos en una app.</string>
    <string name="solution_title">Solución propuesta</string>
    <string name="project_description">Un punto de canje basado en Arduino detecta, con un sensor ultrasónico, cuando el usuario acerca su teléfono a menos de 30 cm. La app recibe la distancia por Bluetooth, genera un código de un solo uso, suma puntos al usuario y lo guarda en SQLite.\n\nDesde la app también se controlan los actuadores del punto de canje: LED de validación, buzzer de aviso y compuerta dispensadora (servomotor).</string>
    <string name="sensor_title">Sensor HC-SR04 (ultrasónico)</string>
    <string name="sensor_description">Mide distancia sin contacto emitiendo un pulso de 40 kHz y midiendo el tiempo del eco.\n\n• Modelo: HC-SR04\n• Rango: 2–400 cm (precisión ≈ 3 mm)\n• Ángulo efectivo: 15°\n• Alimentación: 5 V DC, 15 mA\n• Pines: VCC, TRIG (D6), ECHO (D5), GND\n• Uso en el proyecto: detectar presencia del usuario a ≤ 30 cm</string>
    <string name="actuators_title">Actuadores del punto de canje</string>
    <string name="actuators_description">• LED de validación (D13)\n• Buzzer de aviso (D8)\n• Servomotor SG90 – compuerta dispensadora (D9)</string>
    <string name="tech_title">Tecnología de comunicación</string>
    <string name="tech_description">Bluetooth Clásico (SPP) entre la app Android y el módulo HC-05/HC-06 conectado al Arduino Uno.\n\n• Protocolo: RFCOMM (Serial Port Profile)\n• Velocidad: 9600 baud\n• Alcance: ~10 m\n• Seguridad: vinculación con PIN, solo dispositivos vinculados</string>

